# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# Optional email notifications, sent via Google Workspace SMTP.
# SMTP_APP_PASSWORD is a Google App Password (requires 2-Step Verification on SMTP_USER).
SMTP_USER=
SMTP_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
FROM_EMAIL=417 Wildlife Alliance <info@417wildlifealliance.org>

# Optional Stripe donation checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public production URL used for SEO canonical URLs, Open Graph, robots, and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only when ready for a public launch. Until then, the site blocks
# search-engine crawling and indexing site-wide (robots.txt disallow-all + noindex).
SITE_LAUNCHED=
